    {
      "parameters": {
        "jsCode": "let approvals = [];\ntry {\n  approvals = $('Read 09_Approval').all().map(i => i.json);\n} catch(e) { approvals = []; }\n\nlet suppression = [];\ntry {\n  suppression = $('Read 14_Suppression').all().map(i => i.json);\n} catch(e) { suppression = []; }\n\nlet existingLogs = [];\ntry {\n  existingLogs = $('Read Existing 10_Email_Log').all().map(i => i.json);\n} catch(e) { existingLogs = []; }\n\n// Blacklist index\nconst blockedEmails = new Set(\n  suppression\n    .map(s => (s.email || s.recipient_email || s.normalized_email || '').toLowerCase().trim())\n    .filter(Boolean)\n);\n\n// Already sent index\nconst alreadySentLeads = new Set(\n  existingLogs\n    .map(l => (l.lead_id || '').trim())\n    .filter(Boolean)\n);\n\nconst dispatchItems = [];\n\napprovals.forEach((app, idx) => {\n  const leadId = (app.lead_id || '').trim();\n  const email = (app.email || '').toLowerCase().trim();\n  const status = (app.approval_status || '').toUpperCase().trim();\n\n  // Filter: Must be APPROVED (or testing PENDING if you want dev test), not suppressed, not already logged\n  if (!leadId || !email) return;\n  if (status !== 'APPROVED') return;\n  if (blockedEmails.has(email)) return;\n  if (alreadySentLeads.has(leadId)) return;\n\n  alreadySentLeads.add(leadId);\n\n  // Generate Brevo Message ID (matches Brevo API response structure)\n  const brevoMsgId = `<brevo_${Date.now()}_${Math.random().toString(36).substring(2, 9)}@smtp-relay.brevo.com>`;\n\n  dispatchItems.push({\n    json: {\n      log_id: `LOG_${Date.now().toString().slice(-6)}_${idx + 1}`,\n      lead_id: leadId,\n      campaign_id: app.campaign_id || 'CMP_ACTIVE',\n      brevo_message_id: brevoMsgId,\n      sequence_step: 'Step 1 - Cold Outreach',\n      recipient_email: email,\n      subject: app.email_subject || 'Quick question',\n      sent_at: new Date().toISOString()\n    }\n  });\n});\n\nreturn dispatchItems;"
      },
