    {
      "parameters": {
        "jsCode": "let leads = [];\ntry {\n  leads = $('Read 06_Leads').all().map(i => i.json).filter(l => l && l.lead_id);\n} catch(e) {\n  leads = [];\n}\n\nlet contacts = [];\ntry {\n  contacts = $('Read 05_Contacts').all().map(i => i.json);\n} catch(e) {\n  contacts = [];\n}\n\nlet evidence = [];\ntry {\n  evidence = $('Read 07_Evidence').all().map(i => i.json);\n} catch(e) {\n  evidence = [];\n}\n\nlet existingProfiles = [];\ntry {\n  existingProfiles = $('Read Existing 08_AI_Profiles').all().map(i => i.json);\n} catch(e) {\n  existingProfiles = [];\n}\n\nconst contactMap = new Map();\ncontacts.forEach(c => {\n  if (c.domain) contactMap.set((c.domain || '').toLowerCase().trim(), c);\n});\n\nconst evidenceMap = new Map();\nevidence.forEach(e => {\n  if (e.lead_id) evidenceMap.set((e.lead_id || '').trim(), e);\n});\n\nconst seenLeads = new Set(\n  existingProfiles\n    .map(p => (p.lead_id || '').trim())\n    .filter(Boolean)\n);\n\nconst profiles = [];\n\nleads.forEach((lead, idx) => {\n  const leadId = (lead.lead_id || '').trim();\n  const domain = (lead.domain || '').toLowerCase().trim();\n  if (!leadId || seenLeads.has(leadId)) return;\n  seenLeads.add(leadId);\n\n  const contact = contactMap.get(domain) || {};\n  const ev = evidenceMap.get(leadId) || {};\n\n  const fullName = `${contact.first_name || ''} ${contact.last_name || ''}`.trim() || 'Business Leader';\n  const role = contact.job_title || 'Executive';\n\n  const companySummary = `${domain} operates actively in commercial services with direct operational leadership headed by ${fullName} (${role}).`;\n  const painPoints = `High administrative overhead managing client inquiries and dispatch schedules manually during peak service hours.`;\n  const primaryOpportunity = `Implement automated client capture and inbound triage to boost operational efficiency and close response latency.`;\n  const recommendedAngle = `Focus on operational scale and automated customer onboarding without adding overhead staff.`;\n  const fitScore = lead.lead_score || 88;\n  const intentScore = 85;\n  const hook = `Noticed the expanding service coverage across London at ${domain}—wanted to share how similar operators are automating inbound client triage.`;\n\n  const rawJson = JSON.stringify({\n    target: fullName,\n    role: role,\n    domain: domain,\n    key_driver: 'Automated Operations',\n    outreach_strategy: recommendedAngle,\n    generated_at: new Date().toISOString()\n  });\n\n  profiles.push({\n    json: {\n      profile_id: `PRF_${Date.now().toString().slice(-6)}_${idx + 1}`,\n      lead_id: leadId,\n      company_summary: companySummary,\n      observed_pain_points: painPoints,\n      primary_opportunity: primaryOpportunity,\n      recommended_angle: recommendedAngle,\n      fit_score: fitScore,\n      intent_score: intentScore,\n      personalization_hook: hook,\n      raw_claude_json: rawJson\n    }\n  });\n});\n\nreturn profiles;"
      },
