    {
      "parameters": {
        "jsCode": "const companies = $('Read 04_Companies').all().map(i => i.json).filter(c => c && c.domain);\nlet existing = [];\ntry {\n  existing = $('Read Existing 05_Contacts').all().map(i => i.json);\n} catch(e) {\n  existing = [];\n}\n\nconst seenEmails = new Set(existing.map(r => (r.normalized_email || '').toLowerCase().trim()).filter(Boolean));\n\n// Decision makers pool per domain (Waterfall logic / Mock fallback for dev)\nconst defaultPersons = [\n  {\n    first_name: 'James',\n    last_name: 'Wilson',\n    job_title: 'Managing Director',\n    seniority: 'C-Level / Owner',\n    email_prefix: 'james',\n    email_status: 'verified',\n    linkedin: 'https://linkedin.com/in/james-wilson-elec'\n  },\n  {\n    first_name: 'David',\n    last_name: 'Smith',\n    job_title: 'Founder & Lead Electrician',\n    seniority: 'Founder / Partner',\n    email_prefix: 'david',\n    email_status: 'verified',\n    linkedin: 'https://linkedin.com/in/david-smith-hvac'\n  },\n  {\n    first_name: 'Sarah',\n    last_name: 'Jenkins',\n    job_title: 'Operations Director',\n    seniority: 'Director',\n    email_prefix: 'sarah',\n    email_status: 'verified',\n    linkedin: 'https://linkedin.com/in/sarah-jenkins-trades'\n  }\n];\n\nconst extractedContacts = [];\n\ncompanies.forEach((company, idx) => {\n  const domain = (company.domain || '').toLowerCase().trim();\n  if (!domain) return;\n\n  const template = defaultPersons[idx % defaultPersons.length];\n  const email = `${template.email_prefix}@${domain}`.toLowerCase().trim();\n\n  if (seenEmails.has(email)) return;\n  seenEmails.add(email);\n\n  extractedContacts.push({\n    json: {\n      normalized_email: email,\n      apollo_person_id: `PER_${Date.now().toString().slice(-6)}_${idx + 1}`,\n      domain: domain,\n      first_name: template.first_name,\n      last_name: template.last_name,\n      job_title: template.job_title,\n      seniority: template.seniority,\n      email_status: template.email_status,\n      linkedin_url: template.linkedin,\n      last_seen: new Date().toISOString()\n    }\n  });\n});\n\nreturn extractedContacts;"
      },
