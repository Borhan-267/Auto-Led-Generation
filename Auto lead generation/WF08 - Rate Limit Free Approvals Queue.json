    {
      "parameters": {
        "jsCode": "let leads = [];\ntry {\n  leads = $('Read 06_Leads').all().map(i => i.json).filter(l => l && l.lead_id);\n} catch(e) { leads = []; }\n\nlet companies = [];\ntry {\n  companies = $('Read 04_Companies').all().map(i => i.json);\n} catch(e) { companies = []; }\n\nlet contacts = [];\ntry {\n  contacts = $('Read 05_Contacts').all().map(i => i.json);\n} catch(e) { contacts = []; }\n\nlet profiles = [];\ntry {\n  profiles = $('Read 08_AI_Profiles').all().map(i => i.json);\n} catch(e) { profiles = []; }\n\nlet existingApprovals = [];\ntry {\n  existingApprovals = $('Read Existing 09_Approvals').all().map(i => i.json);\n} catch(e) { existingApprovals = []; }\n\nconst compMap = new Map();\ncompanies.forEach(c => {\n  if (c.domain) compMap.set((c.domain || '').toLowerCase().trim(), c);\n});\n\nconst contactMap = new Map();\ncontacts.forEach(ct => {\n  if (ct.normalized_email) contactMap.set((ct.normalized_email || '').toLowerCase().trim(), ct);\n});\n\nconst profileMap = new Map();\nprofiles.forEach(p => {\n  if (p.lead_id) profileMap.set((p.lead_id || '').trim(), p);\n});\n\nconst seenLeads = new Set(\n  existingApprovals\n    .map(a => (a.lead_id || '').trim())\n    .filter(Boolean)\n);\n\nconst approvalQueue = [];\n\nleads.forEach((lead) => {\n  const leadId = (lead.lead_id || '').trim();\n  const email = (lead.normalized_email || '').toLowerCase().trim();\n  const domain = (lead.domain || '').toLowerCase().trim();\n  if (!leadId || seenLeads.has(leadId)) return;\n  seenLeads.add(leadId);\n\n  const company = compMap.get(domain) || {};\n  const contact = contactMap.get(email) || {};\n  const profile = profileMap.get(leadId) || {};\n\n  const compName = company.company_name || domain;\n  const firstName = contact.first_name || 'there';\n  const contactFullName = `${contact.first_name || ''} ${contact.last_name || ''}`.trim() || firstName;\n  const hook = profile.personalization_hook || `Noticed ${compName}'s growing presence in commercial trade services.`;\n\n  const subject = `Question regarding operational scaling at ${compName}`;\n  const body = `Hi ${firstName},\\n\\n${hook}\\n\\nWe help commercial trade operators automate inbound customer triage, dispatch qualification, and appointment bookings without increasing administrative staff.\\n\\nWould you be open to a 10-minute chat next Tuesday to see how this fits into ${compName}'s current workflow?\\n\\nBest regards,\\nGrowth Team`;\n\n  approvalQueue.push({\n    json: {\n      lead_id: leadId,\n      campaign_id: lead.campaign_id || 'CMP_ACTIVE',\n      company_name: compName,\n      contact_name: contactFullName,\n      email: email,\n      email_subject: subject,\n      email_body: body,\n      approval_status: 'PENDING',\n      reviewed_by: '',\n      reviewed_at: ''\n    }\n  });\n});\n\nreturn approvalQueue;"
      },
