    {
      "parameters": {
        "jsCode": "let logs = [];\ntry {\n  logs = $('Read 10_Email_Log').all().map(i => i.json).filter(l => l && l.lead_id);\n} catch(e) { logs = []; }\n\nlet approvals = [];\ntry {\n  approvals = $('Read 09_Approval').all().map(i => i.json);\n} catch(e) { approvals = []; }\n\nlet existingPipeline = [];\ntry {\n  existingPipeline = $('Read Existing 13_Pipeline').all().map(i => i.json);\n} catch(e) { existingPipeline = []; }\n\nconst approvalMap = new Map();\napprovals.forEach(a => {\n  if (a.lead_id) approvalMap.set(a.lead_id.trim(), a);\n});\n\nconst seenLeads = new Set(\n  existingPipeline\n    .map(p => (p.lead_id || '').trim())\n    .filter(Boolean)\n);\n\nconst pipelineDeals = [];\n\nlogs.forEach((log, idx) => {\n  const leadId = (log.lead_id || '').trim();\n  if (!leadId || seenLeads.has(leadId)) return;\n  seenLeads.add(leadId);\n\n  const approvalData = approvalMap.get(leadId) || {};\n  const compName = approvalData.company_name || 'Commercial Operator';\n  const contactName = approvalData.contact_name || 'Business Owner';\n\n  pipelineDeals.push({\n    json: {\n      deal_id: `DEAL_${Date.now().toString().slice(-6)}_${idx + 1}`,\n      lead_id: leadId,\n      company_name: compName,\n      contact_name: contactName,\n      stage: 'OUTREACH_SENT',\n      expected_value: '£2,500',\n      next_action: 'Follow-up Email (Day 3)',\n      last_updated: new Date().toISOString()\n    }\n  });\n});\n\nreturn pipelineDeals;"
      },
