    {
      "parameters": {
        "jsCode": "let campaigns = [];\ntry {\n  campaigns = $('Read 03_Campaigns').all().map(i => i.json).filter(c => c && c.campaign_id);\n} catch(e) {\n  campaigns = [];\n}\nconst activeCampaignId = campaigns.length ? campaigns[campaigns.length - 1].campaign_id : 'CMP_DEFAULT_001';\n\nlet contacts = [];\ntry {\n  contacts = $('Read 05_Contacts').all().map(i => i.json).filter(c => c && c.normalized_email);\n} catch(e) {\n  contacts = [];\n}\n\nlet existingLeads = [];\ntry {\n  existingLeads = $('Read Existing 06_Leads').all().map(i => i.json);\n} catch(e) {\n  existingLeads = [];\n}\n\nconst seenEmails = new Set(\n  existingLeads\n    .map(r => (r.normalized_email || '').toLowerCase().trim())\n    .filter(Boolean)\n);\n\nconst qualifiedLeads = [];\n\ncontacts.forEach((contact, idx) => {\n  const email = (contact.normalized_email || '').toLowerCase().trim();\n  if (!email || seenEmails.has(email)) return;\n  seenEmails.add(email);\n\n  const title = (contact.job_title || '').toLowerCase();\n  const seniority = (contact.seniority || '').toLowerCase();\n  const emailStatus = (contact.email_status || '').toLowerCase();\n\n  // Scoring Algorithm\n  let score = 50;\n\n  // Role weighting\n  if (title.includes('founder') || title.includes('owner') || seniority.includes('owner')) {\n    score += 30;\n  } else if (title.includes('director') || title.includes('managing') || seniority.includes('c-level')) {\n    score += 25;\n  } else if (title.includes('lead') || title.includes('head') || title.includes('manager')) {\n    score += 15;\n  }\n\n  // Email verification weighting\n  if (emailStatus === 'verified') {\n    score += 15;\n  } else if (emailStatus === 'catch_all') {\n    score += 5;\n  }\n\n  // Priority Classification\n  let priority = 'Tier 3';\n  if (score >= 85) {\n    priority = 'Tier 1';\n  } else if (score >= 70) {\n    priority = 'Tier 2';\n  }\n\n  qualifiedLeads.push({\n    json: {\n      lead_id: `LEAD_${Date.now().toString().slice(-6)}_${idx + 1}`,\n      campaign_id: activeCampaignId,\n      domain: contact.domain || (email.split('@')[1] || ''),\n      normalized_email: email,\n      lead_status: 'QUALIFIED',\n      lead_score: score,\n      priority_class: priority,\n      created_at: new Date().toISOString()\n    }\n  });\n});\n\nreturn qualifiedLeads;"
      },
