    {
      "parameters": {
        "jsCode": "// Match control row with preset and normalize parameters\nconst control = $('Filter Trigger YES').first().json;\nconst presets = $items('Read 02_Presets').map(i => i.json);\n\nif (!control.industry_category || !control.country || !control.quantity) {\n  throw new Error('Validation Error: Missing industry_category, country, or quantity.');\n}\n\n// Match preset by category name\nconst matchedPreset = presets.find(p => \n  p.category_name.trim().toLowerCase() === control.industry_category.trim().toLowerCase()\n);\n\nif (!matchedPreset) {\n  throw new Error(`Preset Error: No preset found for category \"${control.industry_category}\".`);\n}\n\nconst requestedQty = parseInt(control.quantity, 10);\nconst targetQuantity = Math.min(isNaN(requestedQty) ? 25 : requestedQty, 100);\n\n// Compute buffer: 2.5x to account for dedup and low confidence drop-offs\nconst discoveryTargetPool = Math.ceil(targetQuantity * 2.5);\n\n// Generate Deterministic Campaign ID\nconst countryCode = control.country.trim().toUpperCase().slice(0, 3);\nconst cleanCat = control.industry_category.toLowerCase().replace(/[^a-z0-9]/g, '_').slice(0, 12);\nconst ts = new Date().toISOString().replace(/[-:T]/g, '').slice(0, 12);\nconst campaignId = `CMP_${countryCode}_${cleanCat}_${ts}`;\n\n// Safe JSON parsing helper\nconst safeParse = (str) => {\n  try { return typeof str === 'string' ? JSON.parse(str) : str; } catch(e) { return str; }\n};\n\nreturn [{\n  json: {\n    campaign_id: campaignId,\n    campaign_name: control.campaign_name || `${control.industry_category} - ${control.country}`,\n    industry_category: control.industry_category,\n    country: control.country,\n    state_region: control.state_region || null,\n    target_quantity: targetQuantity,\n    discovery_target_pool: discoveryTargetPool,\n    employee_range: control.employee_range || safeParse(matchedPreset.employee_ranges)[0],\n    titles: control.titles ? control.titles.split(',').map(t => t.trim()) : safeParse(matchedPreset.default_titles),\n    research_depth: control.research_depth || 'Standard',\n    marketing_intent_mode: control.marketing_intent_mode || 'Growth-intent priority',\n    send_mode: control.send_mode || 'Approval + send',\n    preset_id: matchedPreset.preset_id,\n    apollo_industry_tags: safeParse(matchedPreset.apollo_industry_tags),\n    service_library: safeParse(matchedPreset.service_library),\n    pain_point_library: safeParse(matchedPreset.pain_point_library),\n    scoring_weights: safeParse(matchedPreset.scoring_weights),\n    exclusions: safeParse(matchedPreset.exclusions),\n    status: 'QUEUED',\n    created_at: new Date().toISOString()\n  }\n}];"
      },
