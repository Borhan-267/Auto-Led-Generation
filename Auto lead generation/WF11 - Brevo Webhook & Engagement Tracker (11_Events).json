      "parameters": {
        "jsCode": "let logs = [];\ntry {\n  logs = $('Read 10_Email_Log').all().map(i => i.json);\n} catch(e) {\n  logs = [];\n}\n\n// Index logs by brevo_message_id\nconst logMap = new Map();\nlogs.forEach(l => {\n  if (l.brevo_message_id) {\n    logMap.set(l.brevo_message_id.trim(), l);\n  }\n});\n\n// Check if triggered via Webhook or Manual Test\nlet incoming = $input.first() ? $input.first().json : {};\nlet body = incoming.body || incoming;\n\nlet messageId = body['message-id'] || body.message_id || body.brevo_message_id;\nlet eventType = body.event || body.event_type || 'opened';\n\n// Fallback for manual testing using first existing logged email\nif (!messageId && logs.length > 0) {\n  messageId = logs[0].brevo_message_id;\n  eventType = 'opened';\n}\n\nconst matchedLog = messageId ? logMap.get(messageId.trim()) : null;\nconst leadId = matchedLog ? matchedLog.lead_id : (body.lead_id || (logs[0] ? logs[0].lead_id : 'LEAD_UNKNOWN'));\n\nconst eventData = JSON.stringify({\n  ip: body.ip || '127.0.0.1',\n  user_agent: body['user-agent'] || 'Mozilla/5.0',\n  link: body.url || null,\n  reason: body.reason || null,\n  provider: 'brevo'\n});\n\nreturn [{\n  json: {\n    event_id: `EVT_${Date.now().toString().slice(-6)}_${Math.floor(Math.random() * 900 + 100)}`,\n    brevo_message_id: messageId || 'MOCK_MSG_ID',\n    lead_id: leadId,\n    event_type: eventType.toUpperCase(),\n    event_data: eventData,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
