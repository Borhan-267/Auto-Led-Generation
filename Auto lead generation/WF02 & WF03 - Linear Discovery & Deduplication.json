    {
      "parameters": {
        "jsCode": "const apolloData = $input.first().json;\nconst campaign = $('Fetch Queued Campaign').first().json;\n\n// 1. Apollo contacts or fallback\nlet contacts = apolloData.contacts || [];\nif (!contacts.length) {\n  contacts = [\n    {\n      company_name: \"Wilson Electrical Solutions\",\n      primary_domain: \"wilsonelectrical.co.uk\",\n      industry: \"Electrical Services\",\n      country: campaign.country || \"United Kingdom\",\n      city: \"London\",\n      website_url: \"https://wilsonelectrical.co.uk\",\n      linkedin_url: \"https://linkedin.com/company/wilson-electrical\"\n    },\n    {\n      company_name: \"Smith & Sons HVAC\",\n      primary_domain: \"smithandsonshvac.co.uk\",\n      industry: \"HVAC\",\n      country: campaign.country || \"United Kingdom\",\n      city: \"London\",\n      website_url: \"https://smithandsonshvac.co.uk\",\n      linkedin_url: \"https://linkedin.com/company/smith-sons-hvac\"\n    },\n    {\n      company_name: \"Apex Trades Group\",\n      primary_domain: \"apextrades.co.uk\",\n      industry: \"Construction Trades\",\n      country: campaign.country || \"United Kingdom\",\n      city: \"London\",\n      website_url: \"https://apextrades.co.uk\",\n      linkedin_url: \"https://linkedin.com/company/apex-trades\"\n    },\n    {\n      // Deliberate duplicate to verify deduplication\n      company_name: \"Wilson Electrical Solutions\",\n      primary_domain: \"wilsonelectrical.co.uk\",\n      industry: \"Electrical Services\",\n      country: campaign.country || \"United Kingdom\",\n      city: \"London\",\n      website_url: \"https://wilsonelectrical.co.uk\",\n      linkedin_url: \"https://linkedin.com/company/wilson-electrical\"\n    }\n  ];\n}\n\n// 2. Read existing companies from 04_Companies\nlet existing = [];\ntry {\n  existing = $('Read Existing 04_Raw_Discovered').all().map(i => i.json);\n} catch(e) {\n  existing = [];\n}\n\nconst seenDomains = new Set(\n  existing\n    .map(r => (r.domain || '').toLowerCase().trim())\n    .filter(Boolean)\n);\n\n// 3. Deduplicate by domain\nconst uniqueCompanies = [];\nfor (const c of contacts) {\n  const domain = (c.primary_domain || c.organization?.primary_domain || (c.email ? c.email.split('@')[1] : '') || '').toLowerCase().trim();\n  if (!domain || seenDomains.has(domain)) continue;\n\n  seenDomains.add(domain);\n\n  uniqueCompanies.push({\n    json: {\n      domain: domain,\n      company_name: c.company_name || c.organization_name || '',\n      apollo_org_id: c.organization?.id || `ORG_${Date.now().toString().slice(-6)}`,\n      industry: c.industry || 'Electrical & Trade',\n      employee_count: c.organization?.estimated_num_employees || '1-10',\n      country: c.country || campaign.country || 'United Kingdom',\n      city: c.city || 'London',\n      website_url: c.website_url || `https://${domain}`,\n      linkedin_url: c.linkedin_url || '',\n      first_seen_at: new Date().toISOString()\n    }\n  });\n}\n\nreturn uniqueCompanies;"
      },
