    {
      "parameters": {
        "jsCode": "let leads = [];\ntry {\n  leads = $('Read 06_Leads').all().map(i => i.json).filter(l => l && l.lead_id);\n} catch(e) {\n  leads = [];\n}\n\nlet existingEv = [];\ntry {\n  existingEv = $('Read Existing 07_Evidence').all().map(i => i.json);\n} catch(e) {\n  existingEv = [];\n}\n\nconst seenLeads = new Set(\n  existingEv\n    .map(e => (e.lead_id || '').trim())\n    .filter(Boolean)\n);\n\nconst evidenceRecords = [];\n\nleads.forEach((lead, idx) => {\n  const leadId = (lead.lead_id || '').trim();\n  const domain = (lead.domain || '').toLowerCase().trim();\n  if (!leadId || seenLeads.has(leadId)) return;\n  seenLeads.add(leadId);\n\n  const evidenceTypes = ['HIRING_GROWTH', 'TECH_STACK_EXPANSION', 'MARKET_EXPANSION'];\n  const selectedType = evidenceTypes[idx % evidenceTypes.length];\n\n  evidenceRecords.push({\n    json: {\n      evidence_id: `EVD_${Date.now().toString().slice(-6)}_${idx + 1}`,\n      lead_id: leadId,\n      evidence_type: selectedType,\n      raw_signal: `Active operations, licensing compliance verified, and expanding geographic footprint detected for ${domain}.`,\n      source_url: `https://${domain}`,\n      extracted_at: new Date().toISOString()\n    }\n  });\n});\n\nreturn evidenceRecords;"
      },
